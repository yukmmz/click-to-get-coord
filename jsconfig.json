{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "None",
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": ["*.js"],
  "exclude": ["scratch", "node_modules"]
}
